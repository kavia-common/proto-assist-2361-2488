# API Configuration
REACT_APP_API_BASE=/api
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000/ws

# Server Configuration
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_TRUST_PROXY=false

# Build Configuration
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Logging Configuration
# Possible values: debug, info, warn, error, none
REACT_APP_LOG_LEVEL=info

# Feature Flags
# Format: "flag1:true,flag2:false,flag3:true"
REACT_APP_FEATURE_FLAGS=showAdvancedFeatures:false,enableExperimentalUI:false

# Experiments
# Set to 'true' to enable experimental features
REACT_APP_EXPERIMENTS_ENABLED=false

# Demo Login (Development/Testing)
# Enable demo login button on login page for local testing without backend
# Automatically enabled in non-production environments (NODE_ENV !== 'production')
# Set to 'false' to explicitly disable even in development
# Set to 'true' to explicitly enable even in production (not recommended)
REACT_APP_ENABLE_DEMO_LOGIN=true
