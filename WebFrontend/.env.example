# API Configuration
# Priority: REACT_APP_API_BASE > REACT_APP_BACKEND_URL > default '/api'
REACT_APP_API_BASE=/api
REACT_APP_BACKEND_URL=http://localhost:8000

# Frontend Configuration
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket Configuration
REACT_APP_WS_URL=ws://localhost:3000/ws

# Environment
REACT_APP_NODE_ENV=development

# Server Configuration
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_HEALTHCHECK_PATH=/health

# Logging
REACT_APP_LOG_LEVEL=info

# Feature Flags
# Format: "flag1:true,flag2:false"
REACT_APP_FEATURE_FLAGS=

# Experiments
REACT_APP_EXPERIMENTS_ENABLED=false

# Build Configuration
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_NEXT_TELEMETRY_DISABLED=1
